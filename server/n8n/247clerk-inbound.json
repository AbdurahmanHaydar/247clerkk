    {
      "parameters": {
        "jsCode": "// Flattens Meta's webhook payload into the shape the 247clerk API expects.\n// Status-only events (delivered / read / deleted) carry no messages[] and are\n// dropped here so they never reach the app.\nconst out = [];\n\nfor (const item of $input.all()) {\n  const payload = item.json;\n  const messages = payload.messages;\n  if (!Array.isArray(messages) || messages.length === 0) continue;\n\n  const meta = payload.metadata || {};\n  const contact = (payload.contacts || [])[0] || {};\n\n  for (const m of messages) {\n    let text = null;\n    if (m.type === 'text') {\n      text = m.text?.body ?? null;\n    } else if (m.type === 'interactive') {\n      text = m.interactive?.button_reply?.title ?? m.interactive?.list_reply?.title ?? null;\n    } else if (m.type === 'button') {\n      text = m.button?.text ?? null;\n    }\n\n    out.push({\n      json: {\n        phoneNumberId: meta.phone_number_id,\n        displayPhoneNumber: meta.display_phone_number,\n        waId: contact.wa_id || m.from,\n        profileName: contact.profile?.name ?? null,\n        messageId: m.id,\n        timestamp: m.timestamp,\n        type: m.type,\n        text,\n        raw: payload,\n      },\n    });\n  }\n}\n\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1440, -432],
