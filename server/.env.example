# Copy to .env and fill in. .env is gitignored — never commit real values.
PORT=3000
DATABASE_URL=postgres://clerk:CHANGEME@127.0.0.1:5432/clerk

# Shared secret between n8n and this app (x-clerk-secret header on /internal/*).
N8N_SECRET=CHANGEME

# Google AI Studio key. Models are pinned rather than *-latest so intake
# behaviour doesn't shift; the fallback covers the 503s flash throws under load.
GEMINI_API_KEY=CHANGEME
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# n8n aborts the inbound request at 30s and the reply is then composed but never
# sent, so the model is kept well inside that: one attempt gets GEMINI_TIMEOUT_MS
# and all of them together get GEMINI_BUDGET_MS. A model that fails is skipped
# for GEMINI_COOLDOWN_MS so the next message doesn't pay for the same outage.
GEMINI_TIMEOUT_MS=8000
GEMINI_BUDGET_MS=15000
GEMINI_COOLDOWN_MS=60000

# Shared demo WhatsApp number, used to build wa.me deep links (no leading +).
DEMO_WA_NUMBER=27705862968

# Owner-only dashboard at /admin/<token>. Any unguessable string; a UUID is fine
# (`node -e "console.log(crypto.randomUUID())"`). Leave empty and the route 404s.
ADMIN_TOKEN=CHANGEME

# Public origin of the dashboard.
PUBLIC_APP_URL=https://app.247clerk.com

# Visitor capture: turns the IP -> city/ISP lookup on /api/track on or off.
# Only the visitor's IP is sent to the provider. {ip} is substituted.
GEOIP_ENABLED=true
GEOIP_URL=https://ipwho.is/{ip}

# Optional: set to a Cal.com link and /book redirects there.
BOOKING_URL=
